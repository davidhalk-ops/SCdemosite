# Server
PORT=3000
NODE_ENV=production

# VWO Feature Management & Experimentation
VWO_SDK_KEY=your_vwo_sdk_key
VWO_ACCOUNT_ID=your_vwo_account_id

# Encryption key for AES-256-GCM (64-char hex; auto-generated if unset)
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Wingify Commerce
CATALOG_API_KEY=your_wingify_commerce_catalog_api_key
